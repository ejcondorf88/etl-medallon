model Oro
	culture: es-EC
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-EC
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_cliente","dim_fecha","dim_producto","dim_promocion","dim_tienda","fact_ventas"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table dim_cliente
ref table dim_fecha
ref table dim_producto
ref table dim_promocion
ref table dim_tienda
ref table fact_ventas
