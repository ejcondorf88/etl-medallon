	partition fact_ventas = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(Web.Contents("https://uceedu.sharepoint.com/sites/POC/Documentos%20compartidos/General/modelo_estrella.xlsx"), null, true),
				    fact_ventas_Sheet = Origen{[Item="fact_ventas",Kind="Sheet"]}[Data],
				    #"Encabezados promovidos" = Table.PromoteHeaders(fact_ventas_Sheet, [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos",{{"venta_id", type text}, {"fecha_hora", type datetime}, {"hora", Int64.Type}, {"fecha_key", Int64.Type}, {"tienda_key", Int64.Type}, {"producto_key", Int64.Type}, {"cliente_key", Int64.Type}, {"promocion_key", Int64.Type}, {"cantidad", Int64.Type}, {"precio_unitario", type number}, {"descuento_pct", type number}, {"costo_unitario", type number}, {"importe_bruto", type number}, {"importe_descuento", type number}, {"importe_neto", type number}, {"costo_total", type number}, {"margen", type number}, {"es_devolucion", Int64.Type}, {"tiene_promocion", Int64.Type}, {"costo_imputado", Int64.Type}, {"medio_pago", type text}, {"tipo_movimiento", type text}})
				in
				    #"Tipo cambiado"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación
