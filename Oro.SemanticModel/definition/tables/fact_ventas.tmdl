table fact_ventas
	lineageTag: f57e3a36-1b57-4dca-8b81-56a77c38a93e

	measure 'Ventas netas' = SUM ( fact_ventas[importe_neto] )
		formatString: $#,##0.00
		displayFolder: KPIs
		lineageTag: 0e8ff823-6cf8-47fc-b47b-0de96e1a15bf

	measure 'Ventas brutas' = SUM ( fact_ventas[importe_bruto] )
		formatString: $#,##0.00
		displayFolder: KPIs
		lineageTag: 0bd17325-4a26-40c7-89bf-a4b441949590

	measure 'Margen bruto' = SUM ( fact_ventas[margen] )
		formatString: $#,##0.00
		displayFolder: KPIs
		lineageTag: ebefe736-e2a5-4db3-8031-54e3693635ce

	measure '% de margen' = DIVIDE ( [Margen bruto], [Ventas netas] )
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 27dc615f-698a-4f51-88b5-3f8497f44fcf

	measure 'Ticket promedio' = DIVIDE ( [Ventas netas], [Transacciones] )
		formatString: $#,##0.00
		displayFolder: KPIs
		lineageTag: f12fa200-031f-48b1-b5b7-3b87ff817444

	measure '% de devoluciones' =
			DIVIDE (
				ABS ( CALCULATE ( [Ventas netas], fact_ventas[es_devolucion] = 1 ) ),
				CALCULATE ( [Ventas netas], fact_ventas[es_devolucion] = 0 )
			)
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: f4010aeb-ebfe-4fff-8088-90b488acfeea

	measure '% con promoción' = DIVIDE ( CALCULATE ( [Ventas netas], fact_ventas[tiene_promocion] = 1 ), [Ventas netas] )
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: bf7f2328-dbd2-4883-889a-043621b6bc4c

	measure 'Ventas por m2' = DIVIDE ( [Ventas netas], SUM ( dim_tienda[metros2] ) )
		formatString: $#,##0.00
		displayFolder: KPIs
		lineageTag: dd6562d1-4960-4609-9175-a87dc1930ba9

	measure 'Ventas YTD' =
			VAR UltimoHecho =
				IF (
					ISBLANK ( MAX ( fact_ventas[fecha_hora] ) ),
					BLANK (),
					DATE (
						YEAR ( MAX ( fact_ventas[fecha_hora] ) ),
						MONTH ( MAX ( fact_ventas[fecha_hora] ) ),
						DAY ( MAX ( fact_ventas[fecha_hora] ) )
					)
				)
			VAR AnioActual = YEAR ( UltimoHecho )
			RETURN
				IF (
					ISBLANK ( UltimoHecho ),
					BLANK (),
					CALCULATE (
						[Ventas netas],
						FILTER (
							ALL ( dim_fecha ),
							dim_fecha[anio] = AnioActual
								&& dim_fecha[fecha] <= UltimoHecho
						)
					)
				)
		formatString: $#,##0.00
		displayFolder: Time Intelligence
		lineageTag: 5d1c9a44-0e6b-4f2a-9f3d-2b7c8e1a4f52

	measure 'Ventas año anterior' =
			VAR UltimoHecho =
				IF (
					ISBLANK ( MAX ( fact_ventas[fecha_hora] ) ),
					BLANK (),
					DATE (
						YEAR ( MAX ( fact_ventas[fecha_hora] ) ),
						MONTH ( MAX ( fact_ventas[fecha_hora] ) ),
						DAY ( MAX ( fact_ventas[fecha_hora] ) )
					)
				)
			VAR AnioObjetivo = YEAR ( UltimoHecho ) - 1
			VAR MismoPeriodo =
				FILTER (
					ALL ( dim_fecha ),
					dim_fecha[anio] = AnioObjetivo
						&& dim_fecha[fecha]
							<= DATE ( AnioObjetivo, MONTH ( UltimoHecho ), DAY ( UltimoHecho ) )
				)
			RETURN
				IF (
					ISBLANK ( UltimoHecho ),
					BLANK (),
					CALCULATE ( [Ventas netas], MismoPeriodo )
				)
		formatString: $#,##0.00
		displayFolder: Time Intelligence
		lineageTag: 907fbed0-4626-4be0-9069-efc3efd8b4b0

	measure Crecimiento =
			DIVIDE (
				[Ventas YTD] - [Ventas año anterior],
				[Ventas año anterior],
				BLANK ( )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPIs
		lineageTag: 7e213c05-b27b-4e0d-a8bf-f54e268bd3f3

	measure Coste = SUM ( fact_ventas[costo_total] )
		formatString: $#,##0.00
		displayFolder: Base
		lineageTag: 0d4dc214-a44a-4baf-9b7a-c863a8b807f1

	measure Descuentos = SUM ( fact_ventas[importe_descuento] )
		formatString: $#,##0.00
		displayFolder: Base
		lineageTag: f7fd00e6-6ea6-4bde-8f81-e6b2815f954b

	measure 'Ventas a pérdida' =
			CALCULATE (
				SUM ( fact_ventas[margen] ),
				fact_ventas[margen] < 0
			)
		formatString: $#,##0.00;-$#,##0.00
		displayFolder: KPIs
		lineageTag: 79fbe452-1b9f-4f09-8279-e3932ff1307a

	measure '% costo imputado' =
			DIVIDE (
				CALCULATE (
					COUNTROWS ( fact_ventas ),
					fact_ventas[costo_imputado] = 1
				),
				COUNTROWS ( fact_ventas )
			)
		formatString: 0.00%
		displayFolder: KPIs
		lineageTag: 9d8335a7-9176-443f-a61e-a6f6a3d9a28e

	measure 'Descuento efectivo' = DIVIDE ( [Descuentos], [Ventas brutas] )
		formatString: 0.00%
		displayFolder: KPIs
		lineageTag: 86a0feaa-b10c-4e37-bf67-adf70e0f2c4f

	measure 'Clientes no identificados' =
			DIVIDE (
				CALCULATE (
					COUNTROWS ( fact_ventas ),
					fact_ventas[cliente_key] = 0
				),
				COUNTROWS ( fact_ventas )
			)
		formatString: 0.00%
		displayFolder: KPIs
		lineageTag: 7c7c1cdb-c399-481c-997f-88e64e77e16d

	measure Unidades = SUM ( fact_ventas[cantidad] )
		formatString: #,##0
		displayFolder: Base
		lineageTag: 3a7c6027-e446-462a-8413-4f38f72e9431

	measure Transacciones = DISTINCTCOUNT ( fact_ventas[venta_id] )
		formatString: #,##0
		displayFolder: Base
		lineageTag: c477d992-fb82-46ef-a9ca-cb6022ead586

	measure 'Clientes con compra' = CALCULATE ( DISTINCTCOUNT ( fact_ventas[cliente_key] ), fact_ventas[cliente_key] <> 0 )
		formatString: #,##0
		displayFolder: Base
		lineageTag: 1c8d3d8e-e81c-48db-8012-160d19120277

	measure 'Descuento medio' = AVERAGE ( fact_ventas[descuento_pct] )
		formatString: 0.0%
		displayFolder: Base
		lineageTag: 119dac8b-4061-4eaa-9845-47eb5324026f

	measure 'Descuento promedio aplicado' = CALCULATE ( AVERAGE ( fact_ventas[descuento_pct] ), fact_ventas[tiene_promocion] = 1 )
		formatString: 0.0%
		displayFolder: Base
		lineageTag: 0bd060fd-ca99-44f2-b518-f4cc88bd8379

